rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{userId} {
      allow read, delete: if owner(userId);
      // Partial auth documents are valid before onboarding; never accept a different stored UID.
      allow create, update: if owner(userId) && request.resource.data.uid == userId;
      match /{collection}/{documentId} {
        allow read, write: if owner(userId) && collection in [
          'incomeSources', 'incomeEntries', 'projects', 'cryptoTrades', 'categories',
          'expenses', 'recurring', 'goals', 'checkins',
          'freelanceProjects', 'cryptoEntries', 'cryptoHoldings', 'savingsGoals'
        ];
      }
      // The existing contribution repository uses this specific nested path.
      match /savingsGoals/{goalId}/contributions/{contributionId} {
        allow read, write: if owner(userId);
      }
    }
    // Keep unknown top-level paths, subcollections, and deeper descendants denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
