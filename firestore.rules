rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user may read/write ONLY their own data:
    // the profile document users/{uid} AND everything under it
    // (categories, expenses, incomeEntries, goals, ...).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
